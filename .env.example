# Copier ce fichier vers .env et y inscrire vos clés API.
# Le fichier .env est ignoré par .gitignore — il ne sera JAMAIS poussé sur GitHub.

# ----- Copernicus Data Space Ecosystem (Sentinel-2) -----
# https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# Créer un client OAuth2 (Client credentials grant)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ----- Météo-France API Publique -----
# https://portail-api.meteofrance.fr/
# Souscrire à l'API "Données AROME" et copier "applicationId"
# (optionnelle : Open-Meteo est utilisé en fallback si la clé est absente)
METEOFRANCE_API_KEY=

# ----- SHOM (marées) -----
# https://services.data.shom.fr/
# (optionnelle : un calcul harmonique simplifié est utilisé par défaut)
SHOM_API_KEY=

# ----- AirBreizh (H2S, qualité de l'air) -----
# Source open data : https://opendata.airbreizh.asso.fr/
# Fiche métadonnée du flux H2S Algues Vertes :
#   https://opendata.airbreizh.asso.fr/geonetwork/srv/fre/catalog.search#/metadata/353f3c26-c35e-434f-afd3-f54e0ae5e0ef
# Récupérer dans cette fiche l'URL du service WFS et le nom de la couche,
# puis renseigner les deux variables ci-dessous. Si rien n'est défini, on
# tente l'URL par défaut documentée — le pipeline ne plante pas en cas d'échec.
AIRBREIZH_WFS_URL=
AIRBREIZH_LAYER=
